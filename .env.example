# Copy this file to `.env` (same folder) and fill in your key.
# `.env` is git-ignored: it stays on this machine and is only read by the local server.

# Required. Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Optional. Uncomment to change the defaults. ---------------------------

# Claude model used for generation.
# HLANKI_MODEL=claude-opus-4-8

# Where Anki import files are written (one .txt per generation run).
# HLANKI_PENDING_DIR=~/Documents/highlight-anki-zettel/anki-cards/pending

# Your Anki tag vocabulary: one tag per line; new tags are appended here.
# HLANKI_TAGS=~/Documents/highlight-anki-zettel/anki-cards/tags.txt

# Anki deck the cards go into (must already exist in Anki).
# HLANKI_DECK=Default

# Where Zettelkasten notes are written (one file per note).
# HLANKI_NOTES_DIR=~/Documents/highlight-anki-zettel/notes

# Note file format: `markdown` (Obsidian/Logseq/any folder) or `org` (org-roam).
# HLANKI_NOTES_FORMAT=markdown

# Path to the prompts file, if you keep it somewhere else.
# HLANKI_PROMPTS=./prompts.yaml

# Only requests from this Chrome extension ID are accepted. It is fixed by the
# `key` in extension/manifest.json; change both only if you re-key a fork.
# HLANKI_EXTENSION_ID=neengcjabhhombdcejjnonclpdmbhiim
