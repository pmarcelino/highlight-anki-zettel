{
  "manifest_version": 3,
  "name": "Highlight → Anki / Zettel",
  "version": "1.0.0",
  "description": "Highlight any page or PDF; yellow becomes Anki cards, blue becomes Zettelkasten notes, written by Claude via a local server.",
  "key": "",
  "permissions": ["contextMenus", "storage", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Highlight → Anki: toggle highlight mode" },
  "web_accessible_resources": [
    { "resources": ["panel.html"], "matches": ["<all_urls>"] }
  ],
  "commands": {
    "toggle-highlight-mode": {
      "suggested_key": { "default": "Alt+H" },
      "description": "Toggle highlight mode on the current tab"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
